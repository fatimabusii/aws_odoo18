            <field name="name">Customer Move-out Notification</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Important: Vacating Arrangements at Blue Spaces</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
        </record>

