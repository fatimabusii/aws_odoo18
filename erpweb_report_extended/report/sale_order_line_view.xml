<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="sale_line_report_view_tree" model="ir.ui.view">
        <field name="name">sale.order.line.view.tree</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list string="Rental Order">
                <field name="product_id"/>
                <field name="start_date" optional="show"/>
                <field name="return_date" optional="show"/>
                <field name="rental_status" invisible="True"/>
            </list>
        </field>
    </record>

    <record id="product_template_normal_form_inherit_bluespace" model="ir.ui.view">
        <field name="name">product.template.inherit.bluespace</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']/group[1]" position="inside">
                <field name="current_available"/>
            </xpath>
        </field>
    </record>

    <record id="sale_line_report_view_gantt" model="ir.ui.view">
        <field name="name">sale.order.line.gantt</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <gantt
                edit="0"
                create="0"
                date_start="start_date"
                date_stop="return_date"
                default_group_by='product_id'
                sample="1">
                <templates>
                    <div t-name="gantt-popover">
                        
                        <div>
                            <strong>Pickup  — </strong> <t t-out="userTimezoneStartDate.format('L LT')"/>
                        </div>
                        <div>
                            <strong>Return — </strong> <t t-out="userTimezoneStopDate.format('L LT')"/>
                        </div>
                        <div>
                            <strong>Status — </strong> <t t-out="state"/>
                            <t t-if="state == 'draft'">
                                Quotation
                            </t>
                            <t t-elif="state == 'sale'">
                                Sale Order
                            </t>
                            <t t-elif="state == 'done'">
                                Locked
                            </t>
                            <t t-elif="state == 'sent'">
                                Quotation Sent
                            </t>
                            <t t-elif="state == 'cancel'">
                                Cancelled
                            </t>
                        </div>
                    </div>
                </templates>
                <field name="state"/>
            </gantt>
        </field>
    </record>

    

    <record id="view_sale_report_search" model="ir.ui.view">
        <field name="name">sale.order.line.search</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <search string="Rental Order">
                <filter string="Move In Date" name="filter_start_date" date="start_date"/>
                <filter string="Move Out Date" name="filter_return_date" date="return_date"/>
                <filter string="Available Units" name="filter_available_unit" domain="[('state', 'in', ['draft',]), ('rental_status', '=', 'returned')]"/>
                <filter string="Not Available Units" name="filter_available_unit" domain="[('state', 'not in', ['draft', 'cancel']), ('rental_status', '!=', 'returned')]"/>
                <group expand="0" string="Extended Filters...">
                    <field name="product_id"/>
                    <field name="start_date"/>
                    <field name="return_date"/>
                </group>
                <group expand="1" string="Group By">
                    <filter string="Products" name="product" context="{'group_by':'product_id'}"/>
                    <separator/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rental_report_all" model="ir.actions.act_window">
        <field name="name">Rental Order Report</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">gantt,pivot</field>
        <field name="context">{'search_default_product':1, 'group_by':[]}</field>
        <field name="search_view_id" ref="view_sale_report_search"/>
    </record>


    <menuitem id="menu_sale_analysis_report_one"
        name="Bluespace Report"
        parent="sale_renting.rental_menu_root"
        sequence="7"/>

    <!-- <menuitem id="menu_sale_analysis_report_rental"
        name="Rental Order Report"
        action="action_rental_report_all"
        parent="menu_sale_analysis_report_one"
        sequence="1"/> -->

</odoo>
