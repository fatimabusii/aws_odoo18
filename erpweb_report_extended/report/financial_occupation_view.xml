    <record id="action_financial_occupation_report" model="ir.actions.act_window">
        <field name="name">Bluespace Financial Occupation</field>
        <field name="res_model">erpweb.financial.occupation.report</field>
        <field name="view_mode">graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No data yet!
            </p>
            <p>
                Create a new rental order
            </p>
        </field>
    </record>

    <menuitem id="menu_financial_occupation_report"
            name="Bluespace Financial Occupation"
            action="action_financial_occupation_report"
            parent="menu_sale_analysis_report_one"
            />
</odoo>
