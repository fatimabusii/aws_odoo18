<?xml version="1.0"?>
<odoo>
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="bluespace_extended.res_config_settings_view_form_inherit_one"/>
        <field name="arch" type="xml">
        	<xpath expr="//div[@id='sale_renting_product_settings']" position="after">
                <h2>Keyword Configuration</h2>
                <div class="row mt16 o_settings_container" id="sale_renting_product_settings">
            		<div class="col-12 col-lg-6 o_setting_box" id="google_console_setting">
                        <div class="o_setting_left_pane">
                            <field name="is_search_keyword"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="is_search_keyword"/>
                            <div class="content-group" invisible="is_search_keyword == False">
                                <div class="row mt16">
                                    <field name="unit_used_for_keyaword" placeholder="Please Enter comma seprate value"
                                        required="is_search_keyword == True"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="google_console_setting">
                        <div class="col-12 col-lg-12 o_setting_box" id="google_console_setting">
                            <div class="o_setting_left_pane">
                                <field name="is_what_type_of_contents"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="is_what_type_of_contents"/>
                                <div class="content-group" invisible="is_what_type_of_contents == False">
                                    <div class="row mt16">
                                        <field name="contents_for_keyaword" placeholder="Please Enter comma seprate value"
                                            required="is_what_type_of_contents == True"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="google_console_setting">
                        <div class="col-12 col-lg-12 o_setting_box" id="google_console_setting">
                            <div class="o_setting_left_pane">
                                <field name="is_what_type_of_activity"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="is_what_type_of_activity"/>
                                <div class="content-group" invisible="is_what_type_of_activity == False">
                                    <div class="row mt16">
                                        <field name="activity_for_keyaword" placeholder="Please Enter comma seprate value"
                                            required="is_what_type_of_activity == True"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
        	</xpath>
        </field>
    </record>
</odoo>