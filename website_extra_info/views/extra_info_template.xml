<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="extra_info_inherit" inherit_id="website_sale.extra_info" name="Unit Used for">
        <xpath expr="//section[hasclass('s_website_form')]" position="replace">
            <section class="s_website_form" data-vcss="001" data-snippet="s_website_form">
                <div class="container">
                    <t t-set="website_sale_order" t-value="website.sale_get_order()"/>
                    <form action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required s_website_form_no_recaptcha" data-mark="*" data-thanks-page="/order/thanks" data-force_action="shop.sale.order" data-model_name="sale.order" data-success-mode="redirect" data-success-page="/shop/payment" hide-change-model="true">
                        <input type="hidden" name="is_ofc_brd" id="is_ofc_brd" t-att-value="'1' if website_sale_order.is_office_boardroom_product() else '0'"/>
                        <t t-if="not website_sale_order.is_office_boardroom_product()">
                        <h4>
                            1. Please note that for the safety of all customers, there is monitoring of unit contents and activity on the premises. Please confirm what you will use the unit for?
                        </h4>
                        <hr/>
                        <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_custom" data-type="text" data-name="Field">
                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="unit_used_for">
                                    <span class="s_website_form_label_content">Unit Use <span style="color:red;">*</span></span>
                                </label>
                                <div class="col-sm">                       
                                    <select id="unit_used_for" name="unit_used_for"  class="form-control s_website_form_input unit_used_for">
                                        <option value="">Please select...(e.g. Self storage)</option>
                                        <option value="self_unit">Self storage</option>
                                        <option value="e_eommerce">e-Commerce</option>
                                        <option value="tradesman_store">Tradesman Store</option>
                                        <option value="offices">Offices</option>
                                        <option value="dance_studio">Dance Studio</option>
                                        <option value="art_studio">Art Studio</option>
                                        <option value="other">Other</option>
                                    </select>
                                    
                                </div>                    
                            </div>
                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="unit_used_for">
                                    <span class="s_website_form_label_content"> </span>
                                </label>
                                <div class="col-sm" id="used_for_text">
                                    <span class="s_website_form_label_content" style="color:red; font-weight:900">* All fields are required</span>
                                    <input id="used_for_text" type="text" class="form-control s_website_form_input" name="unit_used_for_text" placeholder="Please fill in here:"/>
                                    <textarea class="form-control" name="unit_used_desc" rows="3" style="margin-top:10px" placeholder="Please enter description"></textarea>
                                </div>
                               
                            </div>
                        </div>
                        <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_custom" data-type="text" data-name="Field">
                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="what_content">
                                    <span class="s_website_form_label_content">Contents in Unit <span style="color:red;">*</span></span>
                                </label>
                                <div class="col-sm">                       
                                    <select id="what_content" name="what_content"  class="form-control s_website_form_input what_content">
                                        <option value="">Please select...(e.g. Household Goods)</option>
                                        <option value="household_goods">Household Goods</option>
                                        <option value="vehicle">Vehicle</option>
                                        <option value="documents">Documents</option>                           
                                        <option value="other">Other</option>
                                    </select>
                                    
                                </div>                    
                            </div>
                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="what_content">
                                    <span class="s_website_form_label_content"></span>
                                </label>
                                <div class="col-sm" id="what_content_used">
                                    <span class="s_website_form_label_content" style="color:red; font-weight:900">* All fields are required</span>
                                    <input id="what_content_used" type="text" class="form-control s_website_form_input" name="what_content_text" placeholder="Please fill in here:"/>
                                    <textarea class="form-control" name="what_desc" rows="3" style="margin-top:10px" placeholder="Please enter description"></textarea>
                                </div>
                               
                            </div>
                        </div>

                        <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_custom" data-type="text" data-name="Field">
                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="what_activity">
                                    <span class="s_website_form_label_content">Activity in Unit <span style="color:red;">*</span></span>
                                </label>
                                <div class="col-sm">                       
                                    <select id="what_activity" name="what_activity"  class="form-control s_website_form_input what_activity">
                                        <option value="">Please select...(e.g. Storage)</option>
                                        <option value="storage">Storage</option>
                                        <option value="admin">Admin</option>
                                        <option value="picking">Picking</option>                           
                                        <option value="packing">Packing</option>
                                        <option value="other">Other</option>
                                    </select>
                                    
                                </div>                    
                            </div>
                            <div class="row s_col_no_resize s_col_no_bgcolor">
                                <label class="col-form-label col-sm-auto s_website_form_label" style="width: 200px" for="what_activity_text">
                                    <span class="s_website_form_label_content"> </span>
                                </label>
                                <div class="col-sm" id="what_activity_occur">
                                    <span class="s_website_form_label_content" style="color:red; font-weight:900">* All fields are required</span>
                                    <input id="what_activity_occur" type="text" class="form-control s_website_form_input" name="what_activity_occur" placeholder="Please fill in here:"/>
                                    <textarea class="form-control" name="what_desc" rows="3" style="margin-top:10px" placeholder="Please enter description"></textarea>
                                </div>
                               
                            </div>
                            <!-- KEVIN -->
                                <hr/>
                                <h4>
                                   2. Agree to Lease Agreement
                                    <!-- <span t-esc="website_sale_order.is_office_boardroom_order"/> -->
                                </h4>
                                    <h4 style="color:red;">Please read and accept all lease terms and conditions <a id="required_field" t-att-href="'/attachment/download/aggrement'" style="color:red;" target="_blank"><u>(read here)</u></a> and specifically acknowledge that you are aware of the following important terms below, by ticking each item in the tick boxes provided:</h4>
                                    <input type="checkbox" class="cb-element" /> Prepaid water, sewerage and electricity (on non-solar powered plug circuits)<br/>
                                    <input type="checkbox" class="cb-element" /> No hazardous, explosive, flammable (inclusive but not limited to fuel or gas) or waste materials to be brought onto site unless approved by management. Please click below to request approval (Have hazardous goods? Please describe them to us  <a t-att-href="'/contactus'" target="_blank"><u>here</u></a> for approval to avoid legal claims for undeclared hazardous goods brought onto the Property)
                                    <br/>
                                    <t t-if="not website_sale_order.is_specific_move and not website_sale_order.is_office_boardroom_order">
                                        <input type="checkbox" class="cb-element" /> 1 calendar month notice <br/>
                                    </t>
                                    <input type="checkbox" class="cb-element" /> Permission for us to refuse access if account not up to date <br/>
                                    <input type="checkbox" class="cb-element" /> Permission to sell goods within 45 days of non-payment <br/>
                                    <input type="checkbox" class="cb-element" /> Lessor’s hypotec over goods  <br/>
                                    <input type="checkbox" class="cb-element" /> We do not insure your contents inside the unit,please arrange your own insurance  <br/>
                                    <input type="checkbox" class="cb-element" /> If the Customer is a nuisance to other Customers, commits a Breach of the Agreeement or does not pay his account on time for more than two times, the Landlord may evict the Customer immediately or within 1 months notice  <br/>
                                    <input type="checkbox" class="cb-element" /> I/We concede to a credit check being conducted on me/us <br/>
                                    <input type="checkbox" name="all" id="checkall" /> I have read and accept all Terms and Conditions <br/>
                            </div>
                            </t> <!-- ofc-boardroom if condition -->

                            <input type="hidden" name="is_approved" id="is_approved" t-att-value="'1' if website_sale_order.partner_id.state == 'approve' and website_sale_order.is_office_boardroom_product() else '0'"/>
                            <t t-if="website_sale_order.is_office_boardroom_order">
                                <t t-foreach="website_sale_order.website_order_line" t-as="line">
                                    <t t-if="line.product_id.product_category in ['2_office', '3_boardroom']">
                                        <br/><h4><b>Note :</b></h4>
                                        <input type="checkbox" class="cb-element" />Please note permission is required if the office is desired to be used for any other purpose than an office/boardroom, e.g. functions, parties, conferencing, gatherings and the like , to do so click <a href='/contactus'> here </a> or contact the manager at: 021 300 0645 or email info@bluespaces.co.za <br/>
                                    </t>
                                </t>
                            </t>

                            <div class="mb-0 py-2 col-12 s_website_form_submit s_website_form_no_submit_options">
                                <div style="width: 200px;" class="s_website_form_label"/>
                                <a role="button" href="/shop/checkout" class="btn btn-secondary float-start"><span class="fa fa-chevron-left"/> Previous</a>
                                <a role="button" class="btn btn-primary float-end s_website_form_send  btn_erpweb" href="/shop/confirm_order">Next <span class="fa fa-chevron-right" /></a>
                                <span id="s_website_form_result"></span>
                            </div>
                    </form>
                </div>
            </section>
        </xpath>
    </template>

