<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template name="Thanks Order Page" t-name="order_thanks_extra_info">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_text_block pt40 pb40 o_colored_level " data-snippet="s_text_block">
                    <div class="container s_allow_columns">
                        <div class="row">
                            <div class="col-lg-3"></div>
                            <div class="col-lg-7 col-xl-6 me-lg-auto">
                                <span class="d-block fa fa-4x fa-exclamation-triangle mx-auto rounded-circle bg-primary"/><br/>
                                <h1 class="text-center">Thank You!</h1>
                                <div class="pb16 pt16 s_hr" data-snippet="s_hr" data-name="Separator">
                                    <hr class="mx-auto border-top w-50 border-dark text-center"/>
                                </div>
                                <h5 class="text-center">
                                    Hi <span t-esc="order_id.partner_id.name"/><br/>
                                    <span class="fa fa-check-circle"/>
                                    <span>Thank you, your application will be sent for approval and feedback provided in less than 16 business hours, alternatively contact 021 300 0645 during office hours to expedite the process</span>
                                </h5>
                            </div>
                            <div class="col-lg-1"></div>
                        </div>
                    </div>
                </section>
            </div>
            <input t-if='website.plausible_shared_key' type='hidden' class='js_plausible_push' data-event-name='Lead Generation' data-event-params='{"CTA": "Contact Us"}' />
        </t>
    </template>
</odoo>