<?xml version="1.0"?>
<odoo>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@name='shipping_address_block']" position="inside">
            VAT No: <span t-field="o.partner_id.vat"/>
        </xpath>
        <xpath expr="//t//div[@name='address_not_same_as_shipping']//t//div[1]" position="replace">
            <div t-if="o.partner_id.vat" id="partner_vat_address_not_same_as_shipping">
                VAT No: <span t-field="o.partner_id.vat"/>
            </div>
        </xpath>
        <xpath expr="//div[@name='address_same_as_shipping']//t//div[1]" position="replace">
            <div t-if="o.partner_id.vat" id="partner_vat_address_same_as_shipping">
                VAT No: <span t-field="o.partner_id.vat"/>
            </div>
        </xpath>
        <xpath expr="//div[@name='no_shipping']//t//div[1]" position="replace">
            <div t-if="o.partner_id.vat" id="partner_vat_no_shipping">
                VAT No: <span t-field="o.partner_id.vat"/>
            </div>
        </xpath>
    </template>
</odoo>
