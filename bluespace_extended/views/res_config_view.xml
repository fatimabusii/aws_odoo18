<?xml version="1.0"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_one" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="website_info_settings" position="after">
                <h2>Sales contact details </h2>
                <div class="row mt16 o_settings_container" id="sale_renting_product_settings">
                    <div class="col-12 col-lg-6 o_setting_box" id="google_console_setting">
                        <div class="o_setting_left_pane">
                            <field name="is_note"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="is_note"/>
                            <div class="content-group" invisible="is_note == False">
                                <div class="row mt16">
                                    <field name="sale_note" placeholder="Please Enter comma seprate value"
                                        required="is_note == True" readonly="0"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </block>
        </field>
    </record>
</odoo>