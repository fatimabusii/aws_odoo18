    <template id="sale_subscription.portal_my_subscriptions" name="My Booking">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Booking</t>
            </t>
            <t t-if="not subscriptions">
                <p>You don't have any subscriptions yet.</p>
            </t>
            <t t-if="subscriptions" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th class="w-75">Booking</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <t t-foreach="subscriptions" t-as="subscription">
                    <tr>
                        <td>
                            <a t-att-href="subscription.get_portal_url()"><t t-esc="subscription.display_name"/></a>
                        </td>
                        <td class="text-center" id="subscription_state">
                            <t t-if="subscription.stage_category == 'progress' and not subscription.to_renew and not subscription.is_office_boardroom_order">
                                <t t-if="subscription.is_notice_given">
                                    <span class="badge rounded-pill text-bg-success"><i class="fa fa-fw fa-check"/> Notice Given</span>
                                </t>
                                <t t-if="not subscription.notice_given and subscription.is_website">
                                    <span class="badge rounded-pill text-bg-success"><i class="fa fa-fw fa-check"/> Active</span>
                                </t>

                                <t t-if="not subscription.notice_given and not subscription.is_website and subscription.rental_status == 'return'">
                                    <span class="badge rounded-pill text-bg-success"><i class="fa fa-fw fa-check"/> Active</span>
                                </t>
                            </t>
                            <t t-set="is_website" t-value="subscription.team_id.sudo().is_website"/>
                            <t t-if="is_website and subscription.stage_category in ['progress', 'draft'] and not subscription.to_renew and subscription.is_office_boardroom_order and subscription.rental_status != 'returned'">
                                <span class="badge rounded-pill text-bg-success"><i class="fa fa-fw fa-check"/> Active</span>
                            </t>

                            <t t-if="not is_website and subscription.stage_category in ['progress'] and not subscription.to_renew and subscription.is_office_boardroom_order and subscription.rental_status != 'returned'">
                                <span class="badge rounded-pill text-bg-success"><i class="fa fa-fw fa-check"/> Active</span>
                            </t>

                            <t t-if="subscription.stage_category == 'closed' or subscription.rental_status == 'returned'">
                                <span class="badge rounded-pill text-bg-danger"><i class="fa fa-fw fa-remove"/> Vacated </span>
                            </t>
                        </td>
                        <td class="text-end"><span t-esc="subscription.amount_total" t-options="{'widget': 'monetary', 'display_currency': subscription.currency_id}"/></td>
                    </tr>
                </t>
            </t>
        </t>
    </template>

    <template id="portal.my_account_link" name="Link to frontend portal" inherit_id="portal.user_dropdown">
        <xpath expr="//*[@id='o_logout_divider']" position="before">
        </xpath>
    </template>

