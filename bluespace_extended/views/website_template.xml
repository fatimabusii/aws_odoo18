    <template id="sale_subscription.portal_my_home_menu_subscription" name="Portal layout : subscription menu entry" inherit_id="sale.portal_my_home_menu_sale" priority="10">
         <li id="portal_breadcrumbs_sale" position="after">
             <li t-if="page_name == 'subscription'" t-attf-class="breadcrumb-item #{'active' if not subscription else ''}">
                <a t-if="subscription" t-attf-href="/my/subscription?{{ keep_query() }}">Confirmed Bookings</a>
                <t t-else="">Confirmed Bookings</t>
            </li>
            <li t-if="subscription" class="breadcrumb-item active">
                <span t-field="subscription.type_name"/>
                <t t-esc="subscription.name"/>
            </li>
         </li>
    </template>

    <template id="sale_subscription.portal_my_home_subscription" name="Show Subscriptions" customize_show="True" inherit_id="portal.portal_my_home" priority="90">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Confirmed Bookings</t>
                <t t-set="url" t-value="'/my/subscription'"/>
                <t t-set="placeholder_count" t-value="'subscription_count'"/>
            </t>
        </xpath>
    </template>

    <template id="product_attachments_ids" inherit_id="website_sale.products" name="product attachments">
        <xpath expr="//div[contains(@t-attf-class, 'products_attributes_filters')]" position="after">
            <div style="margin-bottom: 20px;color: red;font-size:18px;"> <span t-esc="request.env.company.sale_note"/></div>
        </xpath>
    </template>

     <template id="product_inherit" inherit_id="website_sale.product" name="erpweb product page">
        <xpath expr="//div[@id='product_full_description']" position="before">
            <div class="text-center" style="margin-bottom: 20px;color: red;font-weight: bolder;font-size:18px;"> <span t-esc="request.env.company.sale_note"/></div>
        </xpath>

        <xpath expr="//div[@id='product_full_description']" position="attributes">
            <attribute name="style">margin-left:120px !important</attribute>
        </xpath>
    </template>
